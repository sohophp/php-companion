{
  "name": "php-companion",
  "displayName": "SoPHP",
  "description": "Stable, on-demand PhpStorm-inspired PHP project workflows for Visual Studio Code.",
  "version": "0.4.5",
  "publisher": "sohophp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sohophp/php-companion.git"
  },
  "homepage": "https://github.com/sohophp/php-companion#readme",
  "bugs": {
    "url": "https://github.com/sohophp/php-companion/issues"
  },
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#07183F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "php",
    "phpstorm",
    "refactor",
    "composer",
    "psr-4"
  ],
  "activationEvents": [
    "onLanguage:php",
    "workspaceContains:composer.json",
    "onCommand:phpCompanion.selectPhpVersion",
    "onCommand:phpCompanion.new.class",
    "onCommand:phpCompanion.importClass",
    "onCommand:phpCompanion.optimizeImports"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "resources/icon.png",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build:packages": "pnpm --filter @php-companion/runtime-probe build && pnpm --filter @php-companion/language-spec build && pnpm --filter @php-companion/phpdoc build && pnpm --filter @php-companion/parser build && pnpm --filter @php-companion/project build && pnpm --filter @php-companion/index build && pnpm --filter @php-companion/type-system build && pnpm --filter @php-companion/interop build && pnpm --filter @php-companion/semantic-provider build && pnpm --filter @php-companion/semantic build && pnpm --filter @php-companion/semantic-provider-host build && pnpm --filter @php-companion/route-provider build && pnpm --filter @php-companion/route-provider-host build && pnpm --filter @php-companion/plugin-api build && pnpm --filter @php-companion/provider-winstar-routes build && pnpm --filter @php-companion/framework-symfony build && pnpm --filter @php-companion/provider-symfony-routes build && pnpm --filter @php-companion/provider-symfony-services build && pnpm --filter @php-companion/provider-symfony-events build && pnpm --filter @php-companion/provider-symfony-controller-contexts build && pnpm --filter @php-companion/framework-doctrine build && pnpm --filter @php-companion/refactor build && pnpm --filter @php-companion/language-server build && pnpm --filter @php-companion/testkit build",
    "build": "pnpm build:packages && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "pnpm build:packages && tsc --noEmit && pnpm --dir packages/php-companion-symfony typecheck",
    "lint": "eslint src test packages scripts esbuild.mjs vitest.config.ts vitest.integration.config.ts",
    "test:packages": "pnpm build:packages && pnpm --filter @php-companion/runtime-probe test && pnpm --filter @php-companion/language-spec test && pnpm --filter @php-companion/phpdoc test && pnpm --filter @php-companion/parser test && pnpm --filter @php-companion/project test && pnpm --filter @php-companion/index test && pnpm --filter @php-companion/type-system test && pnpm --filter @php-companion/interop test && pnpm --filter @php-companion/semantic-provider test && pnpm --filter @php-companion/semantic-provider-host test && pnpm --filter @php-companion/route-provider test && pnpm --filter @php-companion/route-provider-host test && pnpm --filter @php-companion/plugin-api test && pnpm --filter @php-companion/provider-winstar-routes test && pnpm --filter @php-companion/framework-symfony test && pnpm --filter @php-companion/provider-symfony-routes test && pnpm --filter @php-companion/provider-symfony-services test && pnpm --filter @php-companion/provider-symfony-events test && pnpm --filter @php-companion/provider-symfony-controller-contexts test && pnpm --filter @php-companion/framework-doctrine test && pnpm --filter @php-companion/semantic test && pnpm --filter @php-companion/refactor test && pnpm --filter @php-companion/language-server test && pnpm --filter @php-companion/testkit test",
    "test": "pnpm test:packages && pnpm --dir packages/php-companion-symfony test && vitest run",
    "pretest:integration:php": "pnpm --filter @php-companion/runtime-probe build && pnpm --filter @php-companion/language-spec build",
    "test:integration:php": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:extension": "pnpm build && pnpm --dir packages/php-companion-symfony build && node scripts/run-extension-test.mjs ./dist-test/runTest.js",
    "test:extension:core-only": "PHP_COMPANION_TEST_CORE_ONLY=1 pnpm test:extension",
    "test:extension:c1": "pnpm build && tsc -p test/extension/tsconfig.json && PHP_COMPANION_TEST_CORE_ONLY=1 PHP_COMPANION_TEST_C1_ONLY=1 node scripts/run-extension-test.mjs ./dist-test/runTest.js",
    "test:extension:c2": "pnpm build && tsc -p test/extension/tsconfig.json && PHP_COMPANION_TEST_C2_ONLY=1 node scripts/run-extension-test.mjs ./dist-test/runTest.js",
    "test:extension:c1:real-vendor": "composer install --working-dir=test/extension/real-vendor --no-interaction --prefer-dist --no-scripts --no-plugins --no-progress && pnpm build && tsc -p test/extension/tsconfig.json && PHP_COMPANION_TEST_CORE_ONLY=1 PHP_COMPANION_TEST_C1_ONLY=1 PHP_COMPANION_TEST_C1_REAL_VENDOR=1 node scripts/run-extension-test.mjs ./dist-test/runTest.js",
    "test:extension:intelephense": "PHP_COMPANION_TEST_WITH_INTELEPHENSE=1 pnpm test:extension",
    "test:extension:packaged": "pnpm package && pnpm package:symfony && tsc -p test/extension/tsconfig.json && node scripts/run-extension-test.mjs ./dist-test/runPackagedTest.js",
    "test:extension:open-source-profile": "pnpm package:all && tsc -p test/extension/tsconfig.json && node scripts/run-extension-test.mjs ./dist-test/runPackagedTest.js",
    "test:extension:open-source-profile:source": "pnpm build && pnpm --dir packages/php-companion-symfony build && tsc -p test/extension/tsconfig.json && PHP_COMPANION_TEST_PROFILE_SOURCE=1 node scripts/run-extension-test.mjs ./dist-test/runPackagedTest.js",
    "install:open-source-profile": "node scripts/install-open-source-profile.mjs",
    "pretest:extension": "tsc -p test/extension/tsconfig.json",
    "package": "pnpm build && vsce package --no-dependencies",
    "package:symfony": "pnpm --dir packages/php-companion-symfony package",
    "package:open-source-pack": "pnpm --dir packages/php-companion-extension-pack package",
    "package:all": "pnpm package && pnpm package:symfony && pnpm package:open-source-pack",
    "candidate:alpha": "pnpm package:all && pnpm verify:vsix && node scripts/prepare-alpha-candidate.mjs",
    "alpha:preflight": "node scripts/alpha-preflight.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "verify:packages": "pnpm build:packages && node scripts/verify-package-tarballs.mjs",
    "benchmark:index": "pnpm build:packages && node scripts/benchmark-index.mjs",
    "benchmark:editing": "pnpm build:packages && node scripts/benchmark-editing.mjs",
    "benchmark:c2-session": "pnpm build:packages && node scripts/benchmark-c2-session.mjs",
    "benchmark:local-change": "pnpm build:packages && node scripts/benchmark-local-change.mjs",
    "benchmark:references": "pnpm build:packages && node scripts/benchmark-references.mjs",
    "benchmark:reference-candidates": "node scripts/profile-reference-candidates.mjs",
    "benchmark:references:vscode": "tsc -p test/extension/tsconfig.json && node scripts/benchmark-reference-vscode.mjs",
    "check:references:winstar": "node scripts/check-winstar-reference-baseline.mjs",
    "check:f09:doctrine": "pnpm --filter @php-companion/language-server build && node scripts/check-f09-doctrine-workspaces.mjs",
    "check:f09:winstar-routes": "pnpm --filter @php-companion/provider-winstar-routes build && pnpm --filter @php-companion/language-server build && node scripts/check-f09-winstar-routes.mjs",
    "check:references:fast:winstar": "pnpm --filter @php-companion/semantic build && pnpm --filter @php-companion/language-server build && node esbuild.mjs --production && pnpm check:references:winstar",
    "check:references:source-only:winstar": "PHP_COMPANION_BENCHMARK_REFERENCE_SOURCE_ONLY=1 PHP_COMPANION_CHECK_REFERENCE_RELOAD=1 node scripts/check-winstar-reference-baseline.mjs",
    "check:references:source-only-immediate:winstar": "PHP_COMPANION_BENCHMARK_REFERENCE_SOURCE_ONLY=1 PHP_COMPANION_BENCHMARK_REFERENCE_IMMEDIATE=1 PHP_COMPANION_BENCHMARK_PRODUCTION_MODE=1 node scripts/check-winstar-reference-baseline.mjs",
    "check:references:source-only-selected:winstar": "PHP_COMPANION_BENCHMARK_REFERENCE_SOURCE_ONLY=1 PHP_COMPANION_BENCHMARK_PRODUCTION_MODE=1 PHP_COMPANION_CHECK_REFERENCE_RELOAD=1 PHP_COMPANION_CHECK_REFERENCE_SELECTION=1 node scripts/check-winstar-reference-baseline.mjs",
    "benchmark:persistence": "pnpm build:packages && node scripts/benchmark-persistent-index.mjs",
    "audit:workspace": "pnpm build:packages && node scripts/audit-real-workspace.mjs",
    "audit:real-cache": "pnpm build:packages && node scripts/audit-real-cache.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm package:all && pnpm verify:vsix"
  },
  "contributes": {
    "configurationDefaults": {
      "php.suggest.basic": false
    },
    "commands": [
      { "command": "phpCompanion.selectPhpVersion", "title": "%command.selectPhpVersion%", "category": "SoPHP" },
      { "command": "phpCompanion.detectPhpVersions", "title": "%command.detectPhpVersions%", "category": "SoPHP" },
      { "command": "phpCompanion.showCompatibilityReport", "title": "%command.showCompatibilityReport%", "category": "SoPHP" },
      { "command": "phpCompanion.showPerformanceLog", "title": "%command.showPerformanceLog%", "category": "SoPHP" },
      { "command": "phpCompanion.safeMove", "title": "%command.safeMove%", "category": "SoPHP" },
      { "command": "phpCompanion.rebuildIndex", "title": "%command.rebuildIndex%", "category": "SoPHP" },
      { "command": "phpCompanion.importClass", "title": "%command.importClass%", "category": "SoPHP" },
      { "command": "phpCompanion.resolvePastedImports", "title": "%command.resolvePastedImports%", "category": "SoPHP" },
      { "command": "phpCompanion.optimizeImports", "title": "%command.optimizeImports%", "category": "SoPHP" },
      { "command": "phpCompanion.new.class", "title": "%command.new.class%", "category": "SoPHP" },
      { "command": "phpCompanion.new.abstractclass", "title": "%command.new.abstractclass%", "category": "SoPHP" },
      { "command": "phpCompanion.new.interface", "title": "%command.new.interface%", "category": "SoPHP" },
      { "command": "phpCompanion.new.trait", "title": "%command.new.trait%", "category": "SoPHP" },
      { "command": "phpCompanion.new.enum", "title": "%command.new.enum%", "category": "SoPHP" },
      { "command": "phpCompanion.new.test", "title": "%command.new.test%", "category": "SoPHP" },
      { "command": "phpCompanion.copy.fqcn", "title": "%command.copy.fqcn%", "category": "SoPHP" },
      { "command": "phpCompanion.copy.namespace", "title": "%command.copy.namespace%", "category": "SoPHP" },
      { "command": "phpCompanion.copy.classReference", "title": "%command.copy.classReference%", "category": "SoPHP" },
      { "command": "phpCompanion.copy.relativePath", "title": "%command.copy.relativePath%", "category": "SoPHP" },
      { "command": "phpCompanion.goToDefinition", "title": "%command.goToDefinition%", "category": "SoPHP", "enablement": "phpCompanion.hasPhpNavigation" },
      { "command": "phpCompanion.goToImplementation", "title": "%command.goToImplementation%", "category": "SoPHP", "enablement": "phpCompanion.hasPhpNavigation" },
      { "command": "phpCompanion.findReferences", "title": "%command.findReferences%", "category": "SoPHP", "enablement": "phpCompanion.hasPhpNavigation" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "phpCompanion.safeMove", "when": "resourceExtname == .php && (resourceScheme == file || resourceScheme == vscode-remote)", "group": "phpCompanion@0" },
        { "command": "phpCompanion.new.class", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "phpCompanion@1" },
        { "command": "phpCompanion.new.interface", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "phpCompanion@2" },
        { "command": "phpCompanion.new.trait", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "phpCompanion@3" },
        { "command": "phpCompanion.new.enum", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "phpCompanion@4" },
        { "command": "phpCompanion.new.test", "when": "resourceScheme == file || resourceScheme == vscode-remote", "group": "phpCompanion@5" }
      ],
      "editor/context": [
        { "command": "phpCompanion.importClass", "when": "editorLangId == php", "group": "phpCompanion@0" },
        { "command": "phpCompanion.copy.fqcn", "when": "editorLangId == php", "group": "phpCompanion@1" },
        { "command": "phpCompanion.copy.namespace", "when": "editorLangId == php", "group": "phpCompanion@2" },
        { "command": "phpCompanion.copy.classReference", "when": "editorLangId == php", "group": "phpCompanion@3" }
      ]
    },
    "configuration": {
      "title": "SoPHP",
      "properties": {
        "phpCompanion.phpVersion": { "type": "string", "scope": "resource", "enum": ["auto", "7.2", "7.3", "7.4", "8.0", "8.1", "8.2", "8.3", "8.4", "8.5"], "default": "auto", "description": "%config.phpVersion%" },
        "phpCompanion.disabledExtensions": { "type": "array", "scope": "resource", "items": { "type": "string", "enum": ["dom", "filter", "mbstring", "pdo", "simplexml", "xml", "xmlreader", "xmlwriter"] }, "uniqueItems": true, "default": [], "description": "%config.disabledExtensions%" },
        "phpCompanion.phpExecutablePath": { "type": ["string", "null"], "scope": "resource", "default": null, "description": "%config.phpExecutablePath%" },
        "phpCompanion.symfony.environment": { "type": ["string", "null"], "scope": "resource", "default": null, "pattern": "^[A-Za-z0-9_.-]{1,64}$", "description": "%config.symfony.environment%" },
        "phpCompanion.symfony.winstarRoutes.enabled": { "type": "boolean", "scope": "resource", "default": false, "description": "%config.symfony.winstarRoutes.enabled%" },
        "phpCompanion.languageServer.enabled": { "type": "boolean", "scope": "window", "default": true, "description": "%config.languageServer.enabled%" },
        "phpCompanion.semanticProviders": { "type": "array", "scope": "window", "default": [], "description": "%config.semanticProviders%", "items": { "type": "object", "additionalProperties": false, "required": ["providerId", "command"], "properties": { "providerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }, "command": { "type": "string", "minLength": 1 }, "args": { "type": "array", "maxItems": 64, "items": { "type": "string" } }, "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 5000 }, "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216, "default": 4194304 } } } },
        "phpCompanion.routeProviders": { "type": "array", "scope": "window", "default": [], "description": "%config.routeProviders%", "items": { "type": "object", "additionalProperties": false, "required": ["providerId", "command"], "properties": { "providerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" }, "command": { "type": "string", "minLength": 1 }, "args": { "type": "array", "maxItems": 64, "items": { "type": "string" } }, "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 5000 }, "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216, "default": 4194304 }, "cacheUntilInvalidated": { "type": "boolean", "default": false, "description": "%config.routeProviders.cacheUntilInvalidated%" } } } },
        "phpCompanion.diagnostics.disabledCodes": { "type": "array", "scope": "window", "items": { "type": "string" }, "uniqueItems": true, "default": [], "description": "%config.diagnostics.disabledCodes%" },
        "phpCompanion.diagnostics.severity": { "type": "object", "scope": "window", "additionalProperties": { "type": "string", "enum": ["error", "warning", "information", "hint", "off"] }, "default": {}, "description": "%config.diagnostics.severity%" },
        "phpCompanion.composer.includeDevAutoload": { "type": "boolean", "scope": "resource", "default": true, "description": "%config.composer.includeDevAutoload%" },
        "phpCompanion.files.exclude": { "type": "array", "scope": "resource", "items": { "type": "string" }, "default": ["**/vendor/**", "**/.git/**", "**/node_modules/**", "**/var/cache/**", "**/storage/framework/**"], "description": "%config.files.exclude%" },
        "phpCompanion.indexing.mode": { "type": "string", "scope": "resource", "enum": ["off", "onDemand", "progressive", "experimental"], "default": "onDemand", "description": "%config.indexing.mode%" },
        "phpCompanion.indexing.referenceMemoryBudgetMiB": { "type": "integer", "scope": "resource", "minimum": 768, "maximum": 4096, "default": 1536, "description": "%config.indexing.referenceMemoryBudgetMiB%" },
        "phpCompanion.indexing.experimentalSourceOnlyReferences": { "type": "boolean", "scope": "resource", "default": false, "description": "%config.indexing.experimentalSourceOnlyReferences%" },
        "phpCompanion.indexing.maxFiles": { "type": "number", "scope": "resource", "minimum": 100, "default": 10000, "description": "%config.indexing.maxFiles%" },
        "phpCompanion.indexing.maxFileSizeKb": { "type": "number", "scope": "resource", "minimum": 16, "default": 512, "description": "%config.indexing.maxFileSizeKb%" },
        "phpCompanion.indexing.maxTotalMb": { "type": "number", "scope": "resource", "minimum": 1, "default": 128, "description": "%config.indexing.maxTotalMb%" },
        "phpCompanion.indexing.onStartup": { "type": "boolean", "scope": "resource", "default": false, "description": "%config.indexing.onStartup%", "deprecationMessage": "%config.indexing.onStartup.deprecation%" },
        "phpCompanion.imports.onPaste": { "type": "string", "scope": "resource", "enum": ["off", "prompt", "auto"], "default": "prompt", "description": "%config.imports.onPaste%" },
        "phpCompanion.imports.optimize.preview": { "type": "boolean", "scope": "resource", "default": true, "description": "%config.imports.optimize.preview%" },
        "phpCompanion.imports.sort": { "type": "string", "scope": "resource", "enum": ["grouped", "fqcn"], "default": "grouped", "description": "%config.imports.sort%" },
        "phpCompanion.generation.strictTypes": { "type": "boolean", "scope": "resource", "default": true, "description": "%config.generation.strictTypes%" },
        "phpCompanion.experimental.refactoring": { "type": "boolean", "scope": "resource", "default": false, "description": "%config.experimental.refactoring%" },
        "phpCompanion.move.enabled": { "type": "boolean", "scope": "resource", "default": true, "description": "%config.move.enabled%" },
        "phpCompanion.move.preview": { "type": "boolean", "scope": "resource", "default": true, "description": "%config.move.preview%" },
        "phpCompanion.rename.enabled": { "type": "boolean", "scope": "resource", "default": true, "description": "%config.rename.enabled%" },
        "phpCompanion.rename.file": { "type": "string", "scope": "resource", "enum": ["off", "preview", "always"], "default": "preview", "description": "%config.rename.file%" },
        "phpCompanion.rename.phpDoc": { "type": "boolean", "scope": "resource", "default": true, "description": "%config.rename.phpDoc%" },
        "phpCompanion.rename.stringReferences": { "type": "boolean", "scope": "resource", "default": false, "description": "%config.rename.stringReferences%" }
      }
    }
  },
  "extensionDependencies": [],
  "extensionPack": [],
  "dependencies": {
    "@php-companion/plugin-api": "workspace:*",
    "@php-companion/runtime-probe": "workspace:*",
    "@php-companion/parser": "workspace:*",
    "@php-companion/project": "workspace:*",
    "@php-companion/provider-symfony-routes": "workspace:*",
    "@php-companion/provider-symfony-services": "workspace:*",
    "@php-companion/refactor": "workspace:*",
    "@php-companion/language-spec": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "@types/yauzl": "^2.10.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "yauzl": "^3.2.0",
    "minimatch": "^10.2.5",
    "tree-sitter-php": "^0.24.2",
    "web-tree-sitter": "^0.26.11"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
