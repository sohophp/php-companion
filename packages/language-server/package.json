{
  "name": "@php-companion/language-server",
  "version": "0.1.0-alpha.1",
  "description": "Standalone PHP language server for PHP Companion.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sohophp/php-companion.git",
    "directory": "packages/language-server"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "php-companion-language-server": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@php-companion/framework-doctrine": "workspace:^",
    "@php-companion/framework-symfony": "workspace:^",
    "@php-companion/index": "workspace:^",
    "@php-companion/interop": "workspace:^",
    "@php-companion/language-spec": "workspace:^",
    "@php-companion/parser": "workspace:^",
    "@php-companion/project": "workspace:^",
    "@php-companion/refactor": "workspace:^",
    "@php-companion/semantic": "workspace:^",
    "@php-companion/semantic-provider": "workspace:^",
    "@php-companion/semantic-provider-host": "workspace:^",
    "minimatch": "^10.2.5",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
