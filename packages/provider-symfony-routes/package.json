{
  "name": "@php-companion/provider-symfony-routes",
  "version": "0.1.0-alpha.1",
  "description": "Authoritative static Symfony route provider for PHP Companion.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sohophp/php-companion.git", "directory": "packages/provider-symfony-routes" },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "bin": { "php-companion-symfony-routes": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run" },
  "dependencies": {
    "@php-companion/framework-symfony": "workspace:^",
    "@php-companion/parser": "workspace:^",
    "@php-companion/project": "workspace:^",
    "@php-companion/route-provider": "workspace:^",
    "minimatch": "^10.2.4"
  },
  "devDependencies": { "@types/node": "^22.15.0", "typescript": "^5.9.3", "vitest": "^4.1.10" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}
